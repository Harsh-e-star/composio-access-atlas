# Access Atlas research agent (python -m agent.main)
# LLM backend: "claude-cli" (default; uses a logged-in Claude Code CLI) or
# "anthropic" (auto-selected when ANTHROPIC_API_KEY is set).
ATLAS_LLM=
ANTHROPIC_API_KEY=
# Path to the claude binary if it is not on PATH.
CLAUDE_BIN=
# Optional: raises the GitHub search API limit used for MCP discovery (falls back to `gh auth token`).
GITHUB_TOKEN=
