# Composio Access Atlas - Environment Variables
# Copy this file to .env to configure live LLM APIs (Optional)

# ==============================================================================
# LLM Providers (Pick any one, or leave blank for deterministic sandbox mode)
# ==============================================================================

# Option 1: OpenAI API Key (e.g. sk-proj-...)
OPENAI_API_KEY=

# Option 2: Google Gemini API Key (e.g. AIzaSy...)
GEMINI_API_KEY=

# Option 3: Anthropic API Key (e.g. sk-ant-...)
ANTHROPIC_API_KEY=

# Option 4: Local Ollama URL (e.g. http://localhost:11434)
OLLAMA_BASE_URL=

# ==============================================================================
# Model Overrides (Optional)
# ==============================================================================
# OpenAI models: gpt-4o, gpt-4o-mini
# Gemini models: gemini-1.5-flash, gemini-2.0-flash
# Anthropic models: claude-3-5-sonnet-20241022
LLM_MODEL=

# ==============================================================================
# Server Port Configuration
# ==============================================================================
PORT=8000
HOST=0.0.0.0
