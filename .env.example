# Copy to .env (git-ignored) and fill in at least one provider. Never commit .env.
# AI_PROVIDER: auto | gemini | groq | anthropic | claude-cli
# "auto" tries Gemini -> Groq -> Anthropic -> Claude CLI, falling back on quota/errors.
AI_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# Path to the claude binary if it is not on PATH (claude-cli provider; also the
# only provider with web search, used by the independent pass B).
CLAUDE_BIN=
# Optional: higher GitHub search limit for MCP discovery (falls back to `gh auth token`).
GITHUB_TOKEN=
